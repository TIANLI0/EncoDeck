{
  "$schema": "https://raw.githubusercontent.com/TIANLI0/FluentSetup/latest/shared/schemas/fluentsetup.project.schema.json",
  "schemaVersion": 1,
  // EncoDeck installer, built with FluentSetup (build\build-installer.ps1 passes -D Version=<version>).
  //
  // Self-contained WinUI 3 app (.NET and Windows App SDK included). Per-user by default
  // (%LOCALAPPDATA%\Programs\EncoDeck); "for all users" installs into Program Files with UAC.
  //
  // Upgrades, including from the Inno Setup installers up to 1.15.0:
  //   * the Inno install ({48E531A0-...}_is1, per-user or per-machine) is adopted in place and its unins00*.* removed;
  //   * a running EncoDeck is asked to exit (EncoDeck.exe --exit), then closed if it is still running;
  //   * "Start with Windows" follows the app's own Run value "EncoDeck" (the setting in EncoDeck), so an update keeps it.
  // In-app update: EncoDeck runs the setup with /SILENT /SUPPRESSMSGBOXES /NORESTART /CLOSEAPPLICATIONS /RELAUNCH=1
  // /LOG=... and exits: /SILENT shows the progress window (UAC first for a per-machine install), /RELAUNCH=1 starts
  // "EncoDeck.exe --updated". The release asset must stay EncoDeck-Setup-<version>-win-x64.exe for the updater.
  // Uninstall: undoes what EncoDeck changed with administrator rights (codec log session, BthAvctpSvc access, LE Audio
  // hook task, its settings in HKLM\SOFTWARE\EncoDeck and its folder in %ProgramData%\EncoDeck; one UAC prompt, only if
  // one of them is present) and asks before deleting %LOCALAPPDATA%\EncoDeck.
  // Code signing: release builds (CI with the TIANLI0/codesign login) add --sign -D CodesignThumbprint=<Certum
  // certificate>; FluentSetup then signs the setup and the uninstall.exe it installs. Local builds stay unsigned.
  "variables": { "Version": "0.0.0-dev", "CodesignThumbprint": "" },
  "app": {
    "id": "EncoDeck",
    "name": "EncoDeck",
    "publisher": "Tianli",
    "version": "$(Version)",
    "description": "Windows 原生的多品牌耳机控制中心 · Native multi-brand earbuds control center",
    "website": "https://github.com/TIANLI0/EncoDeck",
    "supportUrl": "https://github.com/TIANLI0/EncoDeck/issues",
    "releaseNotesUrl": "https://github.com/TIANLI0/EncoDeck/releases",
    "icon": "../src/EncoDeck.App/Assets/EncoDeck.ico",
    "mainExecutable": "EncoDeck.exe"
  },
  // One package, two builds; setup picks (variantSelection "auto", no choice shown): the shared-runtime build (about
  // 50 MB installed) when this PC already has the .NET 10 runtime and the Windows App Runtime 2.5.1+ ("requirements"),
  // else the self-contained one (about 185 MB). Nothing extra is ever installed. Picked again on every install and
  // in-app update, so a PC that gains or loses the runtimes gets the matching build. Files identical in both are
  // stored once. The labels only show in logs and with /variant.
  "files": {
    "include": ["**/*"],
    "exclude": ["**/*.pdb"],
    "variantSelection": "auto",
    "variants": [
      {
        "id": "selfContained",
        "label": { "en-US": "Standard (runtimes included)" },
        "description": { "en-US": "Includes .NET and the Windows App SDK. Works on any PC without installing anything else." },
        "default": true,
        "source": "../artifacts/EncoDeck-win-x64"
      },
      {
        "id": "shared",
        "label": { "en-US": "Compact (shared runtimes)" },
        "description": { "en-US": "Uses the .NET 10 runtime and the Windows App Runtime installed on this PC; smaller." },
        "source": "../artifacts/EncoDeck-win-x64-shared"
      }
    ]
  },
  // What the shared-runtime build needs: the .NET runtime it targets and the Windows App SDK version it references
  // (Directory.Packages.props; keep in step). Only decides which build is installed: no installer is attached.
  "requirements": {
    "dotNet": [{ "runtime": "core", "version": "10.0.0", "variants": ["shared"] }],
    "windowsAppRuntime": { "required": true, "version": "2.5.1", "variants": ["shared"] }
  },
  "install": {
    "scope": "userOrMachine",
    "defaultScope": "user",
    "userDir": "{LocalAppData}\\Programs\\{AppName}",
    "machineDir": "{ProgramFiles}\\{AppName}",
    "allowCustomDir": true,
    "desktopShortcut": "optionalOff",
    "startMenuShortcut": "on",
    "launchAfterInstall": "optionalOn",
    "minWindowsBuild": 19041,
    "closeCommand": { "run": "EncoDeck.exe", "arguments": ["--exit"] },
    "closeProcesses": ["EncoDeck.exe"],
    "legacyUninstallKeys": ["{48E531A0-79E2-4001-9F04-1F43A8C52FE9}_is1"],
    "relaunchArguments": ["--updated"],
    "cleanup": {
      "removeFiles": ["unins*.exe", "unins*.dat", "unins*.msg"]
    }
  },
  "options": [
    {
      "id": "autostart",
      "label": { "en-US": "Start EncoDeck in the background when Windows starts" },
      "default": false,
      "startup": { "name": "EncoDeck", "arguments": ["--background"] }
    }
  ],
  "uninstall": {
    "removeRunValues": ["EncoDeck"],
    "removeData": ["{LocalAppData}\\EncoDeck\\bluetooth-audio-service-access"],
    "userData": {
      "paths": ["{LocalAppData}\\EncoDeck"],
      "default": false
    },
    "elevated": {
      "ifExists": [
        "{CommonAppData}\\EncoDeck\\Codec",
        "{LocalAppData}\\EncoDeck\\bluetooth-audio-service-access",
        "{CommonAppData}\\EncoDeck\\LeHook\\state.txt"
      ],
      "traceSessions": ["EncoDeck-BthA2dp"],
      "scheduledTasks": ["EncoDeck\\LE Audio hook"],
      "serviceAccess": [{ "service": "BthAvctpSvc", "rights": ["LCRPWP", "RPWPLC"] }],
      // Codec (A2DP codec log) and LeHook (hook copies, state, symbols); LeHook settings the hook reads from HKLM.
      "removeData": ["{CommonAppData}\\EncoDeck"],
      "removeRegistryKeys": ["HKLM\\Software\\EncoDeck"]
    }
  },
  "ui": {
    "license": "../LICENSE",
    "licenseStyle": "inline",
    "localization": "locales",
    "defaultLanguage": "auto"
  },
  "signing": {
    "enabled": false,
    "provider": "signtool",
    "certificateThumbprint": "$(CodesignThumbprint)",
    "timestampUrl": "http://time.certum.pl"
  },
  "output": {
    "directory": "../artifacts/installer",
    "fileName": "EncoDeck-Setup-{Version}-win-{Architecture}.exe",
    "architecture": "x64",
    "compression": "max",
    "includeWinUI": true
  }
}
