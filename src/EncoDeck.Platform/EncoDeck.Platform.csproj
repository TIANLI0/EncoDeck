<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows shell integration that is not UI-framework specific: single instance, startup, settings, logs, fullscreen detection. -->
  <PropertyGroup>
    <TargetFramework>$(EncoDeckWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(EncoDeckMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>EncoDeck.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EncoDeck.Core\EncoDeck.Core.csproj" />
    <ProjectReference Include="..\EncoDeck.Protocol\EncoDeck.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EncoDeck.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The component pins (size and SHA-256 of each component release package). -->
    <EmbeddedResource Include="Components\components.json" LogicalName="EncoDeck.Platform.Components.components.json" />
    <!-- BlueCaster's message texts (app/lang of the pinned release, Apache-2.0 OR MIT). -->
    <EmbeddedResource Include="A2dpBridge\Lang\en.json" LogicalName="EncoDeck.Platform.A2dpBridge.Lang.en.json" />
    <EmbeddedResource Include="A2dpBridge\Lang\zh-CN.json" LogicalName="EncoDeck.Platform.A2dpBridge.Lang.zh-CN.json" />
  </ItemGroup>
</Project>
