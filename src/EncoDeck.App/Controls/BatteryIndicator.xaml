<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.BatteryIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        x:Name="Root"
        HorizontalAlignment="Center"
        Spacing="2"
        AutomationProperties.Name="{x:Bind Item.AutomationText, Mode=OneWay}"
        AutomationProperties.LiveSetting="Polite">
        <!-- Low battery (LowBatteryStates): glyph and level in the critical colour. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Low">
                    <VisualState.Setters>
                        <Setter Target="LevelGlyph.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="LevelValue.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <FontIcon
            x:Name="LevelGlyph"
            HorizontalAlignment="Center"
            FontFamily="{ThemeResource SymbolThemeFontFamily}"
            FontSize="{x:Bind GlyphSize, Mode=OneWay}"
            Glyph="{x:Bind Item.Glyph, Mode=OneWay}"
            Opacity="{x:Bind StaleOpacity(Item.IsStale), Mode=OneWay}" />
        <TextBlock
            x:Name="LevelValue"
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            FontSize="{x:Bind LevelFontSize, Mode=OneWay}"
            Text="{x:Bind Item.LevelText, Mode=OneWay}"
            Opacity="{x:Bind StaleOpacity(Item.IsStale), Mode=OneWay}" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind DisplayLabel(Item.Label, LabelOverride), Mode=OneWay}" />
        <TextBlock
            HorizontalAlignment="Center"
            MaxWidth="120"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Text="{x:Bind Item.FreshnessText, Mode=OneWay}" />
    </StackPanel>
</UserControl>
