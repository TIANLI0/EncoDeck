<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.HotkeyBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls">
    <!-- Click, then press the combination; Esc cancels, Backspace clears. -->
    <StackPanel Spacing="2" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
            <Button x:Name="RecordButton" MinWidth="200" HorizontalContentAlignment="Center" Click="OnRecordClick"
                    PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" LostFocus="OnLostFocus">
                <TextBlock x:Name="KeyText" />
            </Button>
            <Button x:Name="ClearButton" x:Uid="Hotkey_Clear" Style="{StaticResource SubtleButtonStyle}" Padding="8" Click="OnClearClick"
                    ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove">
                <controls:FluentIcon Symbol="dismiss" FontSize="12" />
            </Button>
        </StackPanel>
        <TextBlock x:Name="StatusText" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="260" Style="{StaticResource SecondaryTextStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
