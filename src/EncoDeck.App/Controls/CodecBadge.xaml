<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EncoDeck.App.Controls.CodecBadge"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 VerticalAlignment="Center">
 <!-- The audio tag (filled: a codec the PC streams with; outlined: only the link is known). Clicking it explains where
      the codec comes from and, while Windows' codec log is off, turns it on. -->
 <Button x:Name="Badge" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
  <Border x:Name="Frame">
   <TextBlock x:Name="LabelText" TextTrimming="CharacterEllipsis" />
  </Border>
  <Button.Flyout>
   <Flyout x:Name="Details" Opening="OnOpening">
    <StackPanel Spacing="10" MaxWidth="340">
     <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
     <TextBlock x:Name="ResultText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
     <Button x:Name="Enable" Click="OnEnable" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
    </StackPanel>
   </Flyout>
  </Button.Flyout>
 </Button>
</UserControl>
