<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EncoDeck.App.Controls.CupDeviceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:EncoDeck.App.Controls">
 <UserControl.Resources>
  <!-- Same look as Home's L / R / case badges. -->
  <Style x:Key="BadgeStyle" TargetType="Border">
   <Setter Property="Width" Value="20" />
   <Setter Property="Height" Value="20" />
   <Setter Property="CornerRadius" Value="10" />
   <Setter Property="Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="LevelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
   <Setter Property="FontSize" Value="18" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
 </UserControl.Resources>

 <!-- Home's view of the experimental cup category (shown instead of the headset). Wide: the device
      stage on the left, output and feature support on the right; narrow: stacked. Connecting happens on the Devices page. -->
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid x:Name="Root" MaxWidth="1180" Padding="32,12,32,32" ColumnSpacing="28" RowSpacing="16" SizeChanged="OnRootSizeChanged">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="11*" />
    <ColumnDefinition Width="9*" />
   </Grid.ColumnDefinitions>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>

   <StackPanel x:Name="MainColumn" Spacing="16">
    <StackPanel Spacing="6">
     <TextBlock x:Uid="Cup_Category" Text="Cup device · experimental" Style="{StaticResource SecondaryTextStyle}" />
     <TextBlock x:Name="TitleText" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" />
     <Button x:Name="Switcher" x:Uid="Home_SwitchDevice" Style="{StaticResource SubtleButtonStyle}" Padding="0,0,8,0" Margin="-4,0,0,0"
             HorizontalAlignment="Left" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,0,0,0">
       <TextBlock x:Name="SwitcherText" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" />
       <FontIcon Glyph="&#xE70D;" FontSize="14" VerticalAlignment="Center" Margin="0,6,0,0" />
      </StackPanel>
      <Button.Flyout>
       <MenuFlyout x:Name="SwitcherMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSwitcherOpening" />
      </Button.Flyout>
     </Button>
     <!-- Where a headset shows L / R / case battery: the last level sent per channel. -->
     <StackPanel Orientation="Horizontal" Spacing="14">
      <StackPanel x:Name="LevelHost" Orientation="Horizontal" Spacing="14" />
      <Rectangle x:Name="LevelDivider" Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
       <ProgressRing x:Name="Busy" Width="14" Height="14" Visibility="Collapsed" />
       <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                  AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
     </StackPanel>
     <Grid Margin="0,8,0,0" Height="280">
      <controls:DeviceModelView x:Name="Model" Visibility="Collapsed" />
      <Border x:Name="StillHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Grid>
     <TextBlock x:Name="DetailText" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
    </StackPanel>
   </StackPanel>

   <StackPanel x:Name="SideColumn" Grid.Column="1" VerticalAlignment="Top" Spacing="16">
   <Border x:Name="OutputCard" Style="{StaticResource CardStyle}" Padding="20">
    <StackPanel Spacing="12">
     <TextBlock x:Uid="Cup_Output" Text="Output" Style="{StaticResource BodyStrongTextBlockStyle}" />
     <InfoBar x:Uid="Cup_Warning" IsOpen="True" IsClosable="False" Severity="Warning" Title="Experimental" />
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Uid="Cup_StopAll" Content="Stop all" Click="OnStopAll" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
      <Button x:Uid="Cup_Reconnect" Content="Reconnect" Click="OnReconnect" />
      <Button x:Uid="Cup_Disconnect" Content="Disconnect" Click="OnDisconnect" />
     </StackPanel>
     <StackPanel x:Name="ChannelHost" Spacing="4" />
     <TextBlock x:Name="CommandResult" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Border>

   <Border x:Name="SupportCard" Style="{StaticResource CardStyle}" Padding="20">
    <StackPanel Spacing="8">
     <TextBlock x:Uid="Cup_Support" Text="Feature support" Style="{StaticResource BodyStrongTextBlockStyle}" />
     <StackPanel x:Name="SupportHost" Spacing="6" />
    </StackPanel>
   </Border>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
