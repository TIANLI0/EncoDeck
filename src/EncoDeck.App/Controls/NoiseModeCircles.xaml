<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.NoiseModeCircles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls">
    <UserControl.Resources>
        <!-- HeyMelody's round mode buttons: the selected one is filled with the accent colour. -->
        <Style x:Key="CircleModeButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid x:Name="ModeGrid" ColumnSpacing="8" />
        <!-- The rows of the selected mode; opens and closes smoothly as the mode changes. -->
        <Grid x:Name="RowsHost" Visibility="Collapsed">
            <StackPanel Spacing="16" Padding="0,16,0,0">
                <!-- Level row of the selected mode. -->
                <controls:SegmentedRow x:Name="LevelsRow" Visibility="Collapsed" />
                <!-- The earbuds' own sub-modes of the selected mode (e.g. EarFun's ANC sub-mode); up to four per row. -->
                <controls:SegmentedRow x:Name="SubModesRow" Visibility="Collapsed" />
                <!-- EarFun's manual levels, shown while the "Manual" sub-mode is selected. -->
                <controls:SegmentedRow x:Name="ManualLevelsRow" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
