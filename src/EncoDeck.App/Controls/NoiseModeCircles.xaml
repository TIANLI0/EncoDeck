<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.NoiseModeCircles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- HeyMelody's round mode buttons: the selected one is filled with the accent colour. -->
        <Style x:Key="CircleModeButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="16">
        <Grid x:Name="ModeGrid" ColumnSpacing="8" />
        <StackPanel x:Name="LevelsPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="LevelsTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="LevelsHost" ColumnSpacing="8" />
        </StackPanel>
        <!-- The earbuds' own sub-modes of the selected mode (e.g. EarFun's ANC sub-mode); up to four per row. -->
        <StackPanel x:Name="SubModesPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="SubModesTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="SubModesHost" ColumnSpacing="8" RowSpacing="8" />
        </StackPanel>
        <!-- EarFun's manual levels, shown while the "Manual" sub-mode is selected. -->
        <StackPanel x:Name="ManualLevelsPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="ManualLevelsTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="ManualLevelsHost" ColumnSpacing="8" />
        </StackPanel>
    </StackPanel>
</UserControl>
