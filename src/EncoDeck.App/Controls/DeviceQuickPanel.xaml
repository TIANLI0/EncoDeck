<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.DeviceQuickPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls"
    xmlns:services="using:EncoDeck.App.Services">
    <StackPanel Padding="16,14,16,12" Spacing="12">
        <!-- Header: the artwork and name open EncoDeck; the link button on the right connects or disconnects this PC. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Behind the artwork and texts (which let clicks through), so the whole left part is one target; the codec badges stay their own. -->
            <Button x:Uid="Panel_OpenApp" Grid.ColumnSpan="2" Click="OnOpenApp" Style="{StaticResource SubtleButtonStyle}" Margin="-8,-6"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTipService.ToolTip="Open EncoDeck" AutomationProperties.Name="Open EncoDeck" />
            <controls:DeviceImage x:Name="HeaderArtwork" Height="48" IsHitTestVisible="False" SourcePath="{x:Bind ViewModel.DeviceImagePath, Mode=OneWay}" IsHeadphones="{x:Bind ViewModel.IsHeadphones, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing Width="12" Height="12" IsHitTestVisible="False" IsActive="{x:Bind ViewModel.IsBusyConnecting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusyConnecting, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" IsHitTestVisible="False" />
                    <Border Style="{StaticResource CodecBadgeSubtleStyle}" Visibility="{x:Bind ViewModel.HasBridgeBadge, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.BridgeBadgeDescription, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.BridgeBadgeDescription, Mode=OneWay}">
                        <TextBlock Text="A2DP Bridge" Style="{StaticResource CodecBadgeSubtleTextStyle}" />
                    </Border>
                    <controls:CodecBadge Visibility="{x:Bind ViewModel.HasCodec, Mode=OneWay}" Label="{x:Bind ViewModel.CodecLabel, Mode=OneWay}"
                                      Description="{x:Bind ViewModel.CodecDescription, Mode=OneWay}" IsDetailed="{x:Bind ViewModel.CodecIsDetailed, Mode=OneWay}"
                                      CanEnable="{x:Bind ViewModel.CodecCanEnable, Mode=OneWay}" MaxLabelWidth="180" />
                </StackPanel>
            </StackPanel>
            <!-- The icon names the action: a broken link disconnects, a link connects. Plain icon buttons, like the old "open" one. -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Button x:Uid="Panel_Disconnect" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="36" Padding="0"
                        Command="{x:Bind ViewModel.DisconnectDeviceCommand}" Visibility="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}"
                        IsEnabled="{x:Bind services:Ui.Not(ViewModel.IsChangingConnection), Mode=OneWay}"
                        ToolTipService.ToolTip="Disconnect from this PC" AutomationProperties.Name="Disconnect from this PC">
                    <controls:FluentIcon Symbol="link_dismiss" FontSize="18" Visibility="{x:Bind services:Ui.Collapsed(ViewModel.IsChangingConnection), Mode=OneWay}" />
                </Button>
                <Button x:Uid="Panel_Connect" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="36" Padding="0"
                        Command="{x:Bind ViewModel.ConnectDeviceCommand}" Visibility="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                        IsEnabled="{x:Bind services:Ui.Not(ViewModel.IsChangingConnection), Mode=OneWay}"
                        ToolTipService.ToolTip="Connect to this PC" AutomationProperties.Name="Connect to this PC">
                    <controls:FluentIcon Symbol="link" FontSize="18" Visibility="{x:Bind services:Ui.Collapsed(ViewModel.IsChangingConnection), Mode=OneWay}" />
                </Button>
                <ProgressRing Width="20" Height="20" IsHitTestVisible="False" IsActive="{x:Bind ViewModel.IsChangingConnection, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsChangingConnection, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Battery; faded while not linked (only the last levels read). -->
        <controls:HeadphoneBattery Item="{x:Bind ViewModel.Left}" Visibility="{x:Bind ViewModel.IsHeadphones, Mode=OneWay}" Opacity="{x:Bind ViewModel.BatteryOpacity, Mode=OneWay}" />
        <Grid ColumnSpacing="8" Visibility="{x:Bind EarbudBatteryVisibility(ViewModel.HasDevice, ViewModel.IsHeadphones), Mode=OneWay}" Opacity="{x:Bind ViewModel.BatteryOpacity, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:BatteryIndicator Grid.Column="0" Item="{x:Bind ViewModel.Left}" GlyphSize="20" LevelFontSize="16" />
            <controls:BatteryIndicator Grid.Column="1" Item="{x:Bind ViewModel.Right}" Visibility="{x:Bind ViewModel.Right.IsVisible, Mode=OneWay}" GlyphSize="20" LevelFontSize="16" />
            <controls:BatteryIndicator Grid.Column="2" Item="{x:Bind ViewModel.Case}" Visibility="{x:Bind ViewModel.Case.IsVisible, Mode=OneWay}" GlyphSize="20" LevelFontSize="16" />
        </Grid>

        <!-- Noise control -->
        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsNoiseAvailable, Mode=OneWay}">
            <Grid>
                <TextBlock x:Uid="Panel_Noise" Text="Noise control" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing HorizontalAlignment="Right" Width="12" Height="12" IsActive="{x:Bind ViewModel.IsNoisePending, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsNoisePending, Mode=OneWay}" />
            </Grid>
            <controls:NoiseControlSelector ViewModel="{x:Bind ViewModel}" />
        </StackPanel>

        <!-- Audio connection: earbuds set up for LE Audio switch between LC3 and Classic, keeping every pairing. -->
        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.CanSwitchAudioTransport, Mode=OneWay}">
            <Grid>
                <TextBlock x:Uid="Panel_AudioTransport" Text="Audio connection" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing HorizontalAlignment="Right" Width="12" Height="12" IsActive="{x:Bind ViewModel.IsSwitchingAudioTransport, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSwitchingAudioTransport, Mode=OneWay}" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="LeAudioButton" Style="{StaticResource SegmentToggleStyle}" MinHeight="48" Tag="le" Click="OnTransportClick"
                              IsChecked="{x:Bind ViewModel.IsLeAudio, Mode=OneWay}"
                              IsEnabled="{x:Bind services:Ui.Not(ViewModel.IsSwitchingAudioTransport), Mode=OneWay}">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="LC3" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="LE Audio" Style="{StaticResource SegmentLabelStyle}" Opacity="0.75" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ClassicButton" Grid.Column="1" Style="{StaticResource SegmentToggleStyle}" MinHeight="48" Tag="classic" Click="OnTransportClick"
                              IsChecked="{x:Bind ViewModel.IsClassicAudio, Mode=OneWay}"
                              IsEnabled="{x:Bind services:Ui.Not(ViewModel.IsSwitchingAudioTransport), Mode=OneWay}">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Panel_AudioTransportClassic" Text="Classic" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="A2DP" Style="{StaticResource SegmentLabelStyle}" Opacity="0.75" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </StackPanel>

        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />

        <TextBlock x:Uid="Panel_NoDevice" Text="No supported earbuds paired." Style="{StaticResource SecondaryTextStyle}"
                   Visibility="{x:Bind services:Ui.Collapsed(ViewModel.HasDevice), Mode=OneWay}" />

        <!-- Only when the control channel is unavailable. -->
        <Button x:Uid="Panel_Reconnect" Content="Reconnect" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ReconnectCommand}"
                Visibility="{x:Bind ViewModel.IsControlUnavailable, Mode=OneWay}" />
    </StackPanel>
</UserControl>
