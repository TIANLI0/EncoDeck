<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.NoiseControlSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls">
    <StackPanel Spacing="8">
        <Grid x:Name="ModeGrid" ColumnSpacing="8">
            <ToggleButton x:Name="AncButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="NoiseCancellation">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <controls:FluentIcon Symbol="headphones" FontSize="18" />
                    <TextBlock x:Name="AncLabel" x:Uid="NoiseSelector_Anc" Text="Noise cancelling" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="AdaptiveButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="Adaptive">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <controls:FluentIcon Symbol="sound_wave_circle_sparkle" FontSize="18" />
                    <TextBlock x:Name="AdaptiveLabel" x:Uid="NoiseSelector_Adaptive" Text="Adaptive" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="TransparencyButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="Transparency">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <controls:FluentIcon Symbol="person_sound_spatial" FontSize="18" />
                    <TextBlock x:Name="TransparencyLabel" x:Uid="NoiseSelector_Transparency" Text="Transparency" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="OffButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="Off">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <controls:FluentIcon Symbol="prohibited" FontSize="18" />
                    <TextBlock x:Name="OffLabel" x:Uid="NoiseSelector_Off" Text="Off" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <StackPanel x:Name="LevelsPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="LevelsTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <!-- One equal column per level, aligned with the mode buttons above. -->
            <Grid x:Name="LevelsHost" ColumnSpacing="8" />
        </StackPanel>

        <!-- The earbuds' own sub-modes of the selected mode (e.g. EarFun's ANC sub-mode); up to four per row. -->
        <StackPanel x:Name="SubModesPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="SubModesTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="SubModesHost" ColumnSpacing="8" RowSpacing="8" />
        </StackPanel>

        <!-- EarFun's manual levels, shown while the "Manual" sub-mode is selected. -->
        <StackPanel x:Name="ManualLevelsPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="ManualLevelsTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="ManualLevelsHost" ColumnSpacing="8" />
        </StackPanel>
    </StackPanel>
</UserControl>
