<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EncoDeck.App.Controls.NoiseControlSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls">
    <StackPanel>
        <!-- While a mode waits for the earbuds' answer, a spinner stands in for its icon. -->
        <Grid x:Name="ModeGrid" ColumnSpacing="8">
            <ToggleButton x:Name="AncButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="NoiseCancellation">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <Grid Height="18">
                        <controls:FluentIcon x:Name="AncIcon" Symbol="headphones" FontSize="18" />
                        <ProgressRing x:Name="AncRing" Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="AncLabel" x:Uid="NoiseSelector_Anc" Text="Noise cancelling" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="AdaptiveButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="Adaptive">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <Grid Height="18">
                        <controls:FluentIcon x:Name="AdaptiveIcon" Symbol="sound_wave_circle_sparkle" FontSize="18" />
                        <ProgressRing x:Name="AdaptiveRing" Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="AdaptiveLabel" x:Uid="NoiseSelector_Adaptive" Text="Adaptive" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="TransparencyButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="Transparency">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <Grid Height="18">
                        <controls:FluentIcon x:Name="TransparencyIcon" Symbol="person_sound_spatial" FontSize="18" />
                        <ProgressRing x:Name="TransparencyRing" Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="TransparencyLabel" x:Uid="NoiseSelector_Transparency" Text="Transparency" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="OffButton" Style="{StaticResource SegmentToggleStyle}" Click="OnModeClick" Tag="Off">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <Grid Height="18">
                        <controls:FluentIcon x:Name="OffIcon" Symbol="prohibited" FontSize="18" />
                        <ProgressRing x:Name="OffRing" Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="OffLabel" x:Uid="NoiseSelector_Off" Text="Off" Style="{StaticResource SegmentLabelStyle}" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- The rows of the selected mode; opens and closes smoothly as the mode changes. -->
        <Grid x:Name="RowsHost" Visibility="Collapsed">
            <StackPanel Spacing="8" Padding="0,8,0,0">
                <!-- Level row of the selected mode. -->
                <controls:SegmentedRow x:Name="LevelsRow" Spacing="6" Visibility="Collapsed" />
                <!-- The earbuds' own sub-modes of the selected mode (e.g. EarFun's ANC sub-mode); up to four per row. -->
                <controls:SegmentedRow x:Name="SubModesRow" Spacing="6" Visibility="Collapsed" />
                <!-- EarFun's manual levels, shown while the "Manual" sub-mode is selected. -->
                <controls:SegmentedRow x:Name="ManualLevelsRow" Spacing="6" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
