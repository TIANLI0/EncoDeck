<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EncoDeck.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls"
    xmlns:services="using:EncoDeck.App.Services">
    <Page.Resources>
        <!-- L / R / case badge, like HeyMelody's "Ⓛ60 Ⓡ60". -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LevelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A full-width row that opens another page (title left, value and chevron right). -->
        <Style x:Key="NavigationRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </Page.Resources>

    <!-- Wide: the device stage stays fixed on the left and only the controls scroll (SideScroll);
         narrow: stage and controls stack in MainScroll. HomePage.xaml.cs moves SidePanel between the two. -->
    <Grid>
        <Grid x:Name="PageRoot" MaxWidth="1180" Padding="32,12,32,0" ColumnSpacing="28" RowSpacing="16" SizeChanged="OnPageSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Messages and the no-device / unavailable states. -->
            <StackPanel Grid.ColumnSpan="2" Spacing="16">
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />
                <InfoBar
                    x:Uid="Home_GenericModel"
                    IsOpen="{x:Bind ViewModel.IsGenericModel, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Unrecognized model"
                    Message="{x:Bind ViewModel.GenericModelMessage, Mode=OneWay}" />
                <!-- A2DP Windows Bridge streams to these earbuds over its own adapter, but their controls are unreachable. -->
                <InfoBar
                    x:Uid="Home_Bridge"
                    IsOpen="{x:Bind ViewModel.HasBridgeNotice, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Connected through A2DP Bridge"
                    Message="{x:Bind ViewModel.BridgeMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <HyperlinkButton x:Uid="Home_Bridge_Open" Content="Open Labs" Click="OnOpenLabs" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Ui.Collapsed(ViewModel.HasDevice), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="Home_NoDevice_Title" Text="No supported earbuds found" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="Home_NoDevice_Body" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                                   Text="Pair your earbuds in Windows Bluetooth settings first. EncoDeck finds paired earbuds automatically." />
                        <Button x:Uid="Home_NoDevice_OpenSettings" Content="Open Bluetooth settings" Click="OnOpenBluetoothSettings" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsControlUnavailable, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Home_Unavailable_Title" Text="Earbud controls are unavailable" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Home_Unavailable_Body" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                                   Text="Audio may still work. EncoDeck could not open the earbuds' control channel." />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Home_Reconnect2" Content="Try again" Command="{x:Bind ViewModel.ReconnectCommand}" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="Home_Diagnostics" Content="Diagnostics" Click="OnOpenDiagnostics" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- The device stage: name, levels and the rotatable 3D model (HeyMelody's device page). -->
            <ScrollViewer x:Name="MainScroll" Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-20,0" SizeChanged="OnMainScrollSizeChanged">
            <StackPanel x:Name="MainColumn" Spacing="16" Padding="0,0,20,32">
            <StackPanel x:Name="Stage" Spacing="6" Visibility="{x:Bind ViewModel.HasDevice, Mode=OneWay}">
                <TextBlock x:Name="DeviceNameText" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <!-- With more than one supported headset paired, the name opens a switcher (shown instead of DeviceNameText). -->
                <Button x:Name="DeviceSwitcher" x:Uid="Home_SwitchDevice" Style="{StaticResource SubtleButtonStyle}" Padding="0,0,8,0" Margin="-4,0,0,0"
                        HorizontalAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,0,0,0">
                        <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <FontIcon Glyph="&#xE70D;" FontSize="14" VerticalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="DeviceMenu" Placement="BottomEdgeAlignedLeft" Opening="OnDeviceMenuOpening" />
                    </Button.Flyout>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.Left.HasValue, Mode=OneWay}">
                        <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind ViewModel.Right.IsVisible, Mode=OneWay}"><TextBlock Text="L" Style="{StaticResource BadgeTextStyle}" /></Border>
                        <TextBlock Text="{x:Bind ViewModel.Left.LevelText, Mode=OneWay}" Style="{StaticResource LevelTextStyle}" />
                        <FontIcon Glyph="&#xE945;" FontSize="12" Visibility="{x:Bind ViewModel.Left.IsCharging, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.Right.HasVisibleValue, Mode=OneWay}">
                        <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="R" Style="{StaticResource BadgeTextStyle}" /></Border>
                        <TextBlock Text="{x:Bind ViewModel.Right.LevelText, Mode=OneWay}" Style="{StaticResource LevelTextStyle}" />
                        <FontIcon Glyph="&#xE945;" FontSize="12" Visibility="{x:Bind ViewModel.Right.IsCharging, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.Case.HasVisibleValue, Mode=OneWay}">
                        <Border Style="{StaticResource BadgeStyle}"><FontIcon Glyph="&#xE7F6;" FontSize="11" Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}" /></Border>
                        <TextBlock Text="{x:Bind ViewModel.Case.LevelText, Mode=OneWay}" Style="{StaticResource LevelTextStyle}" />
                        <FontIcon Glyph="&#xE945;" FontSize="12" Visibility="{x:Bind ViewModel.Case.IsCharging, Mode=OneWay}" />
                    </StackPanel>
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsBusyConnecting, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBusyConnecting, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Style="{StaticResource CodecBadgeSubtleStyle}" Visibility="{x:Bind ViewModel.HasBridgeBadge, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BridgeBadgeDescription, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.BridgeBadgeDescription, Mode=OneWay}">
                            <TextBlock Text="A2DP Bridge" Style="{StaticResource CodecBadgeSubtleTextStyle}" />
                        </Border>
                        <controls:CodecBadge Visibility="{x:Bind ViewModel.HasCodec, Mode=OneWay}" Label="{x:Bind ViewModel.CodecLabel, Mode=OneWay}"
                                          Description="{x:Bind ViewModel.CodecDescription, Mode=OneWay}" IsDetailed="{x:Bind ViewModel.CodecIsDetailed, Mode=OneWay}"
                                          CanEnable="{x:Bind ViewModel.CodecCanEnable, Mode=OneWay}" MaxLabelWidth="220" />
                        <!-- Inline with no vertical padding, so showing/hiding it never changes the row height. -->
                        <HyperlinkButton x:Uid="DeviceConnect" Click="OnOpenBluetoothSettings" Padding="2,0" MinHeight="0" VerticalAlignment="Center"
                                         Visibility="{x:Bind ViewModel.IsLinkDown, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                <controls:DeviceModelView x:Name="Model" Height="280" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.DeviceModelPath), Mode=OneWay}"
                                          ModelPath="{x:Bind ViewModel.DeviceModelPath, Mode=OneWay}"
                                          ImagePath="{x:Bind ViewModel.DeviceImagePath, Mode=OneWay}"
                                          IsHeadphones="{x:Bind ViewModel.IsHeadphones, Mode=OneWay}" />
                <controls:DeviceMedia SourcePath="{x:Bind ViewModel.DeviceMotionPath, Mode=OneWay}"
                                      DarkSourcePath="{x:Bind ViewModel.DeviceMotionDarkPath, Mode=OneWay}"
                                      Height="{Binding Height, ElementName=Model}"
                                      IsVideo="{x:Bind ViewModel.DeviceMotionIsVideo, Mode=OneWay}"
                                      FallbackPath="{x:Bind ViewModel.DeviceImagePath, Mode=OneWay}"
                                      IsHeadphones="{x:Bind ViewModel.IsHeadphones, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasDeviceMotion, Mode=OneWay}" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" Margin="0,12,0,4"
                            Visibility="{x:Bind ViewModel.HasComponentArtwork, Mode=OneWay}">
                    <StackPanel Spacing="6" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.LeftArtworkPath), Mode=OneWay}">
                        <controls:DeviceMedia Width="72" Height="64" SourcePath="{x:Bind ViewModel.LeftArtworkPath, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasComponentArtwork, Mode=OneWay}" />
                        <TextBlock x:Uid="Artwork_Left" Text="Left earbud" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.RightArtworkPath), Mode=OneWay}">
                        <controls:DeviceMedia Width="72" Height="64" SourcePath="{x:Bind ViewModel.RightArtworkPath, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasComponentArtwork, Mode=OneWay}" />
                        <TextBlock x:Uid="Artwork_Right" Text="Right earbud" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.CaseArtworkPath), Mode=OneWay}">
                        <controls:DeviceMedia Width="72" Height="64" SourcePath="{x:Bind ViewModel.CaseArtworkPath, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasComponentArtwork, Mode=OneWay}" />
                        <TextBlock x:Uid="Artwork_Case" Text="Charging case" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Controls (HeyMelody's device page sections). -->
            <StackPanel x:Name="SidePanel" Spacing="16" Visibility="{x:Bind ViewModel.HasDevice, Mode=OneWay}">
                <Border x:Name="NoiseCard" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock x:Uid="Home_NoiseControl" Text="Noise control" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsNoisePending, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsNoisePending, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.NoiseText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <controls:NoiseModeCircles ViewModel="{x:Bind ViewModel}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DevicesCard" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock x:Uid="Home_Devices" Text="Device management" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Uid="Home_DevicesMore" Content="More" HorizontalAlignment="Right" Padding="4,2" Click="OnOpenControls" />
                        </Grid>
                        <controls:SettingRow x:Name="DualRow" x:Uid="Home_Dual" Header="Dual connection">
                            <ToggleSwitch x:Name="DualSwitch" Style="{StaticResource TrailingSwitchStyle}" Toggled="OnDualToggled" />
                        </controls:SettingRow>
                        <Grid x:Name="DeviceHost" ColumnSpacing="8" MinHeight="104" />
                    </StackPanel>
                </Border>

                <Border x:Name="SoundCard" Style="{StaticResource CardStyle}" Padding="20,12">
                    <StackPanel>
                        <TextBlock x:Uid="Home_SoundCard" Text="Sound" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
                        <Button x:Name="EqRow" Style="{StaticResource NavigationRowStyle}" Click="OnOpenSound">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Home_Eq" Text="Earbud EQ" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EqualizerText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button x:Name="SpatialRow" Style="{StaticResource NavigationRowStyle}" Click="OnOpenSound">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Home_Spatial" Text="Spatial audio" VerticalAlignment="Center" />
                                <TextBlock x:Name="SpatialValue" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                            </Grid>
                        </Button>
                        <controls:SettingRow x:Name="GameRow" x:Uid="Home_GameMode" Header="Game mode" Margin="0,4,0,8">
                            <ToggleSwitch x:Name="GameSwitch" Style="{StaticResource TrailingSwitchStyle}" Toggled="OnGameToggled" />
                        </controls:SettingRow>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- The scroll bar sits in the page gutter (negative margin) instead of over the cards. -->
            <ScrollViewer x:Name="SideScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-20,0" Visibility="Collapsed">
                <Border x:Name="SideHost" Padding="0,0,20,32" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
