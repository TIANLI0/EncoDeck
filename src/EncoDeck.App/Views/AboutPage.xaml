<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EncoDeck.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls"
    xmlns:services="using:EncoDeck.App.Services">
    <Page.Resources>
        <!-- Links sit in text flow: no button padding, so they line up with the labels above them. -->
        <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="LinkRowStyle" TargetType="controls:WrapPanel">
            <Setter Property="HorizontalSpacing" Value="16" />
            <Setter Property="VerticalSpacing" Value="4" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Not the max-width element itself: a ScrollViewer centres its child by the child's desired width, which shifts it off-screen once the viewport is wider than the max width. -->
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,8,32,32" Spacing="16">

            <!-- App -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/EncoDeck-256.png" Width="72" Height="72" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="EncoDeck" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="About_Tagline" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="Manage your earbuds on Windows — no more reaching for your phone just to switch noise cancelling." />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}" Margin="0,2,0,0">
                            <HyperlinkButton x:Uid="Settings_Source" Content="Source code" NavigateUri="https://github.com/TIANLI0/EncoDeck" />
                            <HyperlinkButton x:Uid="About_Compatibility" Content="Device compatibility" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/docs/COMPATIBILITY.md" />
                            <HyperlinkButton x:Uid="About_Changelog" Content="Changelog" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/CHANGELOG.md" />
                        </controls:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Updates (GitHub Releases); the Store build is updated by the Store -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Ui.Visible(ViewModel.HasSelfUpdate)}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Updates" Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="{x:Bind ViewModel.CurrentVersionText}" Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}">
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Uid="Settings_CheckUpdates" Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RunUpdateActionCommand}" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsUpdateActionVisible), Mode=OneWay}" />
                        </controls:WrapPanel>
                    </controls:SettingRow>
                    <ProgressBar Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsUpdateDownloading), Mode=OneWay}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.UpdateReleaseNotes), Mode=OneWay}">
                        <TextBlock x:Uid="Settings_StoreReleaseNotes" Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.UpdateReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </StackPanel>
                    <HyperlinkButton x:Uid="Settings_ReleaseNotes" Content="Release notes" NavigateUri="{x:Bind ViewModel.ReleaseNotesUrl, Mode=OneWay}"
                                     Visibility="{x:Bind services:Ui.Visible(ViewModel.HasReleaseNotes), Mode=OneWay}" />
                    <controls:SettingRow x:Uid="Settings_AutoUpdate" Header="Check for updates automatically"
                                         Description="Downloads new versions in the background and lets you know. Nothing is installed until you choose to.">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow x:Uid="Settings_Prerelease" Header="Receive preview versions" Description="Also offer pre-releases. They may be less stable.">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.IncludePrereleaseUpdates, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Updates through the Microsoft Store (MSIX build) -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Ui.Collapsed(ViewModel.HasSelfUpdate)}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Updates" Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="{x:Bind ViewModel.CurrentVersionText}" Description="{x:Bind ViewModel.StoreUpdateStatus, Mode=OneWay}">
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Uid="Settings_CheckUpdates" Content="Check for updates" Command="{x:Bind ViewModel.CheckStoreUpdatesCommand}" />
                            <Button x:Uid="Settings_StoreUpdate" Style="{StaticResource AccentButtonStyle}" Content="Update"
                                    Command="{x:Bind ViewModel.InstallStoreUpdateCommand}" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsStoreUpdateAvailable), Mode=OneWay}" />
                        </controls:WrapPanel>
                    </controls:SettingRow>
                    <StackPanel Spacing="4" Visibility="{x:Bind services:Ui.VisibleIfText(ViewModel.StoreReleaseNotes), Mode=OneWay}">
                        <TextBlock x:Uid="Settings_StoreReleaseNotes" Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.StoreReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </StackPanel>
                    <controls:SettingRow x:Uid="Settings_StoreAutoUpdate" Header="Check for updates automatically"
                                         Description="Lets you know when a new version is available.">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Developer -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_DeveloperLabel" Text="Developer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="44" Height="44" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="ms-appx:///Assets/Author.png" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tianli" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                                <HyperlinkButton Content="wutianli@tianli0.top" NavigateUri="mailto:wutianli@tianli0.top" />
                                <HyperlinkButton Content="GitHub · TIANLI0" NavigateUri="https://github.com/TIANLI0" />
                                <HyperlinkButton Content="tianli0.top" NavigateUri="https://tianli0.top" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sponsor -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_SponsorTitle" Text="Support the developer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_SponsorText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="EncoDeck is free and open source. If it helps you, consider sponsoring its development." />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB51;" FontSize="14" />
                            <TextBlock x:Uid="Settings_SponsorButton" Text="Sponsor" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="Settings_SponsorTitle" Text="Support the developer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <Image Source="ms-appx:///Assets/Support/alipay.png" Width="160" Height="240" Stretch="Uniform" />
                                            <TextBlock x:Uid="Settings_SponsorAlipay" Text="Alipay" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <Image Source="ms-appx:///Assets/Support/wechat.png" Width="176" Height="240" Stretch="Uniform" />
                                            <TextBlock x:Uid="Settings_SponsorWeChat" Text="WeChat Pay" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- Feedback, with the version details an issue report asks for -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_Feedback" Text="Feedback" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="About_FeedbackText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="If the earbuds will not connect, a setting has no effect or the model is recognised wrongly, open an issue with the earbud model, firmware version, Windows version and the steps you took. Test results for models not yet verified are welcome too." />
                    </StackPanel>
                    <controls:SettingRow x:Uid="About_SystemInfo" Header="Version information" Description="{x:Bind SystemInfo}">
                        <Button x:Name="CopyInfo" Click="OnCopySystemInfo" />
                    </controls:SettingRow>
                    <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                        <HyperlinkButton x:Uid="About_ReportIssue" Content="Report an issue" NavigateUri="https://github.com/TIANLI0/EncoDeck/issues" />
                        <HyperlinkButton x:Uid="About_Contributing" Content="Contributing" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/CONTRIBUTING.md" />
                    </controls:WrapPanel>
                </StackPanel>
            </Border>

            <!-- Acknowledgements: projects whose code or protocol research EncoDeck uses (THIRD_PARTY_NOTICES.md sections 1, 3, 7 and 8) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_Thanks" Text="Acknowledgements" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="About_ThanksIntro" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                   Text="EncoDeck builds on the work of these open-source projects. Thanks to their authors and contributors." />
                    </StackPanel>

                    <TextBlock x:Uid="About_ThanksProtocol" Text="Earbud protocol and device support" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="OPPO · OnePlus · realme" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="OppoPodsWindows" NavigateUri="https://github.com/3295074384/OppoPodsWindows" />
                            <HyperlinkButton Content="OppoPodsManager" NavigateUri="https://github.com/Zhaoyi-ya/OppoPodsManager" />
                            <HyperlinkButton Content="QuickBuds" NavigateUri="https://github.com/spizganed/QuickBuds" />
                            <HyperlinkButton Content="OppoPods" NavigateUri="https://github.com/Leaf-lsgtky/OppoPods" />
                            <HyperlinkButton Content="HeyBuds" NavigateUri="https://github.com/abaichuan1017/HeyBuds" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="HUAWEI" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="OpenFreebuds" NavigateUri="https://github.com/melianmiko/OpenFreebuds" />
                            <HyperlinkButton Content="HuaweiPods" NavigateUri="https://github.com/Nshpiter/HuaweiPods" />
                            <HyperlinkButton Content="EZBuds" NavigateUri="https://github.com/CenSher/EZBuds" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Xiaomi · Redmi" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="BudsLink" NavigateUri="https://github.com/maniacx/BudsLink" />
                            <HyperlinkButton Content="redmi-buds-bar" NavigateUri="https://github.com/robin-liquidium/redmi-buds-bar" />
                            <HyperlinkButton Content="mebuds" NavigateUri="https://github.com/paradox-ng/mebuds" />
                            <HyperlinkButton Content="MiBudsClient" NavigateUri="https://github.com/CesurPolat/MiBudsClient" />
                            <HyperlinkButton Content="OpenXia" NavigateUri="https://github.com/thetriu/OpenXia" />
                            <HyperlinkButton Content="XiaomiTWS" NavigateUri="https://github.com/web1n/android_packages_apps_XiaomiTWS" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="vivo · iQOO" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="TWS-Pods-PC" NavigateUri="https://github.com/Zhaoyi-ya/TWS-Pods-PC" />
                            <HyperlinkButton Content="vivopods-mac" NavigateUri="https://github.com/FxRayHughes/vivopods-mac" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="EDIFIER" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="HyperEars" NavigateUri="https://github.com/silverpoetry/HyperEars" />
                            <HyperlinkButton Content="mEDIFIER" NavigateUri="https://github.com/wh201906/mEDIFIER" />
                            <HyperlinkButton Content="Macifier" NavigateUri="https://github.com/luanyufei/Macifier" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="MOONDROP" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="MiuixMoondrop" NavigateUri="https://github.com/huime180/MiuixMoondrop" />
                            <HyperlinkButton Content="FxxkMoondrop" NavigateUri="https://github.com/bqj6666/FxxkMoondrop" />
                            <HyperlinkButton Content="moondrop-control" NavigateUri="https://github.com/FEAKEuser/moondrop-control" />
                            <HyperlinkButton Content="moondrop-pc" NavigateUri="https://github.com/herikk04/moondrop-pc" />
                            <HyperlinkButton Content="Edge2Pods" NavigateUri="https://github.com/Konakonai/Edge2Pods" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Sony · Sennheiser" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="SonyHeadphonesClient" NavigateUri="https://github.com/mos9527/SonyHeadphonesClient" />
                            <HyperlinkButton Content="momentum4-control" NavigateUri="https://github.com/Ariazonaa/momentum4-control" />
                            <HyperlinkButton Content="momentum-menu" NavigateUri="https://github.com/andr3-santos/momentum-menu" />
                            <HyperlinkButton Content="m4-companion" NavigateUri="https://github.com/Zhengyang-Liu/m4-companion" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Samsung · Google · Bose · Nothing" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="GalaxyBudsClient" NavigateUri="https://github.com/timschneeb/GalaxyBudsClient" />
                            <HyperlinkButton Content="Budsy" NavigateUri="https://github.com/vedatkilic/budsy" />
                            <HyperlinkButton Content="PixelBudsMacOS" NavigateUri="https://github.com/KashaMalaga/PixelBudsMacOS" />
                            <HyperlinkButton Content="pbpctrl" NavigateUri="https://github.com/qzed/pbpctrl" />
                            <HyperlinkButton Content="MagicBuds" NavigateUri="https://github.com/artistro08/MagicBuds" />
                            <HyperlinkButton Content="bosectl" NavigateUri="https://github.com/aaronsb/bosectl" />
                            <HyperlinkButton Content="bozo" NavigateUri="https://github.com/NerdySouth/bozo" />
                            <HyperlinkButton Content="swift-nothing-ear" NavigateUri="https://github.com/bestK1ngArthur/swift-nothing-ear" />
                            <HyperlinkButton Content="nothing-x-macos" NavigateUri="https://github.com/nikiomori/nothing-x-macos" />
                            <HyperlinkButton Content="EarA-linux" NavigateUri="https://github.com/oneydef/EarA-linux" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksUsb" Text="USB and 2.4 GHz gaming headsets" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="HeadsetControl" NavigateUri="https://github.com/Sapd/HeadsetControl" />
                            <HyperlinkButton Content="OpenRazer" NavigateUri="https://github.com/openrazer/openrazer" />
                            <HyperlinkButton Content="blackshark-control" NavigateUri="https://github.com/AbdullahSAhmad/blackshark-control" />
                            <HyperlinkButton Content="HaloBattery" NavigateUri="https://github.com/HeyOkay/HaloBattery" />
                            <HyperlinkButton Content="barracuda-x-battery" NavigateUri="https://github.com/nightdevx/barracuda-x-battery" />
                            <HyperlinkButton Content="NPS.HecateBattery" NavigateUri="https://github.com/SnowDreamXUE/NPS.HecateBattery" />
                        </controls:WrapPanel>
                    </StackPanel>

                    <TextBlock x:Uid="About_ThanksComponents" Text="Components and libraries" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksLhdc" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="LHDC V5 component" />
                        <HyperlinkButton Content="LHDC-Win" NavigateUri="https://github.com/Wayne-u/LHDC-Win" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksBridge" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="A2DP Bridge component" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="A2DP Windows Bridge" NavigateUri="https://github.com/SeiyaFunaokaJP/A2DP-Windows-Bridge" />
                            <HyperlinkButton Content="BTstack" NavigateUri="https://github.com/bluekitchen/btstack" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="About_ThanksLibraries" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Text="Libraries" />
                        <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                            <HyperlinkButton Content="Windows App SDK" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                            <HyperlinkButton Content="H.NotifyIcon" NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                            <HyperlinkButton Content="CommunityToolkit.Mvvm" NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                            <HyperlinkButton Content="Lottie-Windows" NavigateUri="https://github.com/CommunityToolkit/Lottie-Windows" />
                            <HyperlinkButton Content="Win2D" NavigateUri="https://github.com/microsoft/Win2D" />
                            <HyperlinkButton Content="Vortice.Windows" NavigateUri="https://github.com/amerkoleci/Vortice.Windows" />
                        </controls:WrapPanel>
                    </StackPanel>
                    <TextBlock x:Uid="About_ThanksAll" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="The third-party notices list every project with the revision used and its license." />
                </StackPanel>
            </Border>

            <!-- Legal -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="About_Legal" Text="Legal" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Settings_Disclaimer" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Text="EncoDeck is an unofficial open-source project with no affiliation, partnership or endorsement from the earbud brands it supports or their manufacturers. Brand and product names are used only to describe compatibility." />
                    <TextBlock x:Uid="Settings_License" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="Licensed under the GNU General Public License v3.0 only (GPL-3.0-only). Third-party notices are included with the app." />
                    <TextBlock x:Uid="About_PrivacyText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="EncoDeck has no accounts, ads, analytics or telemetry. It goes online only for updates, device artwork and the optional components you download." />
                    <controls:WrapPanel Style="{StaticResource LinkRowStyle}">
                        <HyperlinkButton x:Uid="Settings_Notices" Content="Third-party notices" Click="OnOpenNotices" />
                        <HyperlinkButton x:Uid="About_LicenseLink" Content="License" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/LICENSE" />
                        <HyperlinkButton x:Uid="About_Privacy" Content="Privacy policy" NavigateUri="https://github.com/TIANLI0/EncoDeck/blob/main/PRIVACY.md" />
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
