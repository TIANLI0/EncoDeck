<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EncoDeck.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Not the max-width element itself: a ScrollViewer centres its child by the child's desired width, which shifts it off-screen once the viewport is wider than the max width. -->
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,8,32,32" Spacing="16">

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Devices_Paired" Text="Paired earbuds" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="DeviceHost" Spacing="8" />
                    <TextBlock x:Name="NoDevicesText" x:Uid="Devices_None" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="No paired earbuds that EncoDeck supports. Pair them in Windows Bluetooth settings." />
                    <HyperlinkButton x:Uid="Devices_OpenBluetooth" Content="Open Bluetooth settings" Click="OnOpenBluetoothSettings" Padding="0,4" />
                </StackPanel>
            </Border>

            <!-- The connected earbuds: what to quote in a report, and the factory reset where the earbuds take one. -->
            <Border x:Name="InfoCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Devices_Info" Text="Device information" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow x:Name="FirmwareRow" x:Uid="Devices_Firmware" Header="Firmware">
                        <TextBlock Text="{x:Bind ViewModel.FirmwareVersionText, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </controls:SettingRow>
                    <controls:SettingRow x:Name="ProductIdRow" x:Uid="Devices_ProductId" Header="Product ID">
                        <TextBlock Text="{x:Bind ViewModel.ProductIdText, Mode=OneWay}" IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </controls:SettingRow>
                    <controls:SettingRow x:Name="ResetRow" x:Uid="Devices_FactoryReset" Header="Restore factory settings"
                                         Description="Clears every setting and every paired device on the earbuds. Afterwards remove them in Windows Bluetooth settings and pair them again.">
                        <Button x:Uid="Devices_FactoryResetButton" Content="Restore…" Click="OnFactoryResetClick" />
                    </controls:SettingRow>
                    <TextBlock x:Name="ResetResult" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="CapabilityCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Devices_Capabilities" Text="Feature support" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="CapabilityHost" Spacing="6" />
                </StackPanel>
            </Border>

            <!-- Only for MOONDROP and AKG N5 / N9 Hybrid: the switch gates nothing on other brands. -->
            <Border x:Name="MoondropCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <controls:SettingRow x:Name="ExperimentalRow" x:Uid="Settings_MoondropExperimental" Header="Experimental MOONDROP features"
                                     Description="Enable unverified MOONDROP commands and inferred gesture actions. Off by default; use at your own risk.">
                    <ToggleSwitch x:Name="MoondropExperimentalSwitch" Style="{StaticResource TrailingSwitchStyle}" Toggled="OnMoondropExperimentalToggled" />
                </controls:SettingRow>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Devices_Diagnostics" Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Uid="Devices_Diagnostics_Note" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                               Text="Diagnostic exports contain logs and settings. Bluetooth addresses are redacted. For deeper analysis, run EncoDeck.Probe (see docs/TESTING.md)." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Devices_Reconnect" Content="Reconnect control channel" Command="{x:Bind ViewModel.ReconnectCommand}" />
                        <Button x:Uid="Devices_Export" Content="Export diagnostics" Click="OnExportDiagnostics" />
                        <Button x:Uid="Devices_OpenLogs" Content="Open log folder" Click="OnOpenLogs" />
                    </StackPanel>
                    <TextBlock x:Name="ExportResult" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
