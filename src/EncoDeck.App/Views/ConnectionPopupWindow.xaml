<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EncoDeck.App.Views.ConnectionPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EncoDeck.App.Controls"
    xmlns:services="using:EncoDeck.App.Services"
    Title="EncoDeck">

    <!-- Layered (for click-through), so no system backdrop: a solid themed surface instead. -->
    <Grid x:Name="Root"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          Tapped="OnTapped"
          AutomationProperties.LiveSetting="Assertive"
          AutomationProperties.Name="{x:Bind AnnouncementText, Mode=OneTime}">

        <!-- The whole pop-up scales with the user's size setting. -->
        <Viewbox Stretch="Fill">
            <Grid x:Name="Scaled">
                <Grid x:Name="HeadphoneCard" Padding="24,18,24,20" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,24,0" Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button x:Name="HeadphoneClose" x:Uid="Popup_Close" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-12,0"
                                Style="{StaticResource SubtleButtonStyle}" Padding="6" Click="OnCloseClick" AutomationProperties.Name="Close">
                            <controls:FluentIcon Symbol="dismiss" FontSize="10" />
                        </Button>
                    </Grid>
                    <controls:DeviceMedia x:Name="HeadphonePicture" Grid.Row="1" IsHeadphones="True" Margin="10,0" IsHitTestVisible="False" />
                    <controls:HeadphoneBattery Grid.Row="2" Item="{x:Bind ViewModel.Left}" />
                </Grid>
                <Grid x:Name="HuaweiLayout" Visibility="Collapsed">
                    <controls:DeviceMedia x:Name="HuaweiPicture" IsHitTestVisible="False" />
                    <Canvas x:Name="HuaweiLevels" IsHitTestVisible="False">
                        <controls:BatteryIndicator x:Name="HuaweiLeft" Width="52" Item="{x:Bind ViewModel.Left}" GlyphSize="18" LevelFontSize="15" />
                        <controls:BatteryIndicator x:Name="HuaweiRight" Width="52" Item="{x:Bind ViewModel.Right}" GlyphSize="18" LevelFontSize="15" />
                        <controls:BatteryIndicator x:Name="HuaweiCase" Width="52" Item="{x:Bind ViewModel.Case}" GlyphSize="18" LevelFontSize="15" />
                        <TextBlock x:Name="HuaweiTitle" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Canvas>
                </Grid>
                <!-- Official layout (HeyMelody pack): HeyMelody's 320 × 347 dp connection dialog, scaled to
                     the pop-up. The video fills it (centre-crop); the battery levels, pictures and title
                     go where PopupLayout says, built in code. -->
                <Grid x:Name="OfficialLayout" Width="320" Height="347" Visibility="Collapsed">
                    <!-- Silent video frames (SilentVideoPresenter): never a media player, so never media playback. -->
                    <Image x:Name="Video" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Canvas x:Name="ImageLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="LevelLayer" IsHitTestVisible="False" Opacity="0" />
                    <TextBlock x:Name="TitleText"
                               Canvas.ZIndex="1"
                               Margin="24,201.26,24,68"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Medium"
                               LineHeight="26"
                               MaxLines="3"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="WrapWholeWords"
                               IsHitTestVisible="False"
                               Opacity="0"
                               Visibility="Collapsed" />

                    <!-- Shown only on hover, and never in click-through mode. -->
                    <Button x:Name="OfficialClose" x:Uid="Popup_Close"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6"
                            Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" Click="OnCloseClick"
                            AutomationProperties.Name="Close">
                        <controls:FluentIcon Symbol="dismiss" FontSize="10" />
                    </Button>
                </Grid>

                <!-- Compact card, used when no connection video is available. -->
                <!-- Artwork on the left, centred; name, status and levels share one left edge on the right. -->
                <Grid x:Name="Card" Padding="16,12,10,12" ColumnSpacing="18" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="CompactArt" Width="108" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:DeviceMedia x:Name="Picture" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Grid x:Name="ComponentArt" Visibility="Collapsed" IsHitTestVisible="False">
                            <controls:DeviceImage x:Name="CaseArt" Width="80" Height="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            <controls:DeviceImage x:Name="LeftArt" Width="36" Height="62" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,4,0,0" />
                            <controls:DeviceImage x:Name="RightArt" Width="36" Height="62" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,14,0" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="10" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="CardClose" Grid.Column="1" x:Uid="Popup_Close" Click="OnCloseClick" Style="{StaticResource SubtleButtonStyle}" Padding="6" VerticalAlignment="Top" Margin="0,-2,0,0"
                                    AutomationProperties.Name="Close">
                                <controls:FluentIcon Symbol="dismiss" FontSize="10" />
                            </Button>
                        </Grid>
                        <!-- Left-aligned with fixed gaps, so the first level lines up under the name instead of floating mid-column. -->
                        <StackPanel x:Name="BatteryRow" Grid.Row="1" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Left">
                            <controls:BatteryIndicator MinWidth="44" Item="{x:Bind ViewModel.Left}" GlyphSize="18" LevelFontSize="15" />
                            <controls:BatteryIndicator MinWidth="44" Item="{x:Bind ViewModel.Right}" Visibility="{x:Bind ViewModel.Right.IsVisible, Mode=OneWay}" GlyphSize="18" LevelFontSize="15" />
                            <controls:BatteryIndicator MinWidth="44" Item="{x:Bind ViewModel.Case}" Visibility="{x:Bind ViewModel.Case.IsVisible, Mode=OneWay}" GlyphSize="18" LevelFontSize="15" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
