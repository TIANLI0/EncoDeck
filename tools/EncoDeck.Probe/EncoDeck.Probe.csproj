<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless diagnostic tool. Safe by default: write commands require explicit flags. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(EncoDeckWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(EncoDeckMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>EncoDeck.Probe</RootNamespace>
    <AssemblyName>EncoDeck.Probe</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EncoDeck.Core\EncoDeck.Core.csproj" />
    <ProjectReference Include="..\..\src\EncoDeck.Protocol\EncoDeck.Protocol.csproj" />
    <ProjectReference Include="..\..\src\EncoDeck.Bluetooth\EncoDeck.Bluetooth.csproj" />
    <ProjectReference Include="..\..\src\EncoDeck.Platform\EncoDeck.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
